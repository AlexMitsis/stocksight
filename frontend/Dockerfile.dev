# Development Dockerfile for Stock Analysis Frontend
FROM node:20-alpine

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies (use --legacy-peer-deps for GenUI SDK compatibility)
RUN npm ci --legacy-peer-deps

# Expose port
EXPOSE 3000

# For development with hot reload
# Code will be mounted as volume
CMD ["npm", "run", "dev", "--", "--host"]
