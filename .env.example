# Stock Analysis - Environment Variables
# Copy this file to .env and fill in your actual values

# OpenAI API Configuration
OPENAI_API_KEY=your-openai-api-key-here  # For LLM (can be custom endpoint)
OPENAI_EMBEDDINGS_API_KEY=your-openai-embeddings-key-here  # For embeddings (standard OpenAI API)
# Note: OPENAI_EMBEDDINGS_API_KEY is optional but recommended for full RAG functionality
# If not set, will fall back to OPENAI_API_KEY (may not support embeddings)

# Model Configuration (optional - defaults provided)
MODEL_NAME=c1/openai/gpt-5/v-20250930
MODEL_BASE_URL=https://api.thesys.dev/v1/embed/

# Database (handled by Docker Compose in development)
# Only change these if running without Docker
# DATABASE_URL=postgresql://stockanalysis:devpassword@localhost:5432/stockanalysis_dev

# Redis (handled by Docker Compose in development)
# REDIS_URL=redis://localhost:6379/0

# JWT Authentication Configuration
# IMPORTANT: Generate a secure secret key with: openssl rand -hex 32
SECRET_KEY=your-secret-key-here-change-in-production-use-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Configuration
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Server Configuration (optional)
# HOST=0.0.0.0
# PORT=8888
